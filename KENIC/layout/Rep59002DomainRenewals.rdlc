            <Left>1.05in</Left>
            <Height>0.35in</Height>
            <Width>5.3in</Width>
            <ZIndex>1</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="CompanyAddress">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!CompanyInfo_Address.Value &amp; IIf(IsNothing(Fields!CompanyInfo_Address2.Value), "", ", " &amp; Fields!CompanyInfo_Address2.Value) &amp; ", " &amp; Fields!CompanyInfo_City.Value</Value>
                    <Style>
                      <FontSize>8pt</FontSize>
                      <TextAlign>Left</TextAlign>
                      <Color>#333333</Color>
                      <PaddingLeft>0.05in</PaddingLeft>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.5in</Top>
            <Left>1.05in</Left>
            <Height>0.2in</Height>
            <Width>5.3in</Width>
            <ZIndex>2</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="ContactInfo">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Tel: " &amp; Fields!CompanyInfo_Phone.Value &amp; " | Email: " &amp; Fields!CompanyInfo_Email.Value</Value>
