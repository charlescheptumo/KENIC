  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>
          <Image Name="Logo">
            <Source>Database</Source>
            <Value>=Fields!CompanyInfo_Picture.Value</Value>
            <MIMEType>image/png</MIMEType>
            <Top>0.1in</Top>
            <Left>0.1in</Left>
            <Height>0.7in</Height>
            <Width>0.7in</Width>
            <Style>
              <Border>
                <Style>None</Style>
              </Border>
            </Style>
          </Image>
          <Textbox Name="CompanyName">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!CompanyInfo_Name.Value</Value>
                    <Style>
                      <FontSize>14pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextAlign>Left</TextAlign>
                      <Color>#1a3c6e</Color>
                      <PaddingLeft>0.05in</PaddingLeft>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.1in</Top>
            <Left>1in</Left>
            <Height>0.3in</Height>
            <Width>5.3in</Width>
            <ZIndex>1</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="CompanyAddress">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>=Fields!CompanyInfo_Address.Value &amp; IIf(IsNothing(Fields!CompanyInfo_Address2.Value), "", ", " &amp; Fields!CompanyInfo_Address2.Value) &amp; ", " &amp; Fields!CompanyInfo_City.Value</Value>
                    <Style>
                      <FontSize>8pt</FontSize>
                      <TextAlign>Left</TextAlign>
                      <Color>#333333</Color>
                      <PaddingLeft>0.05in</PaddingLeft>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.4in</Top>
            <Left>1in</Left>
            <Height>0.2in</Height>
            <Width>5.3in</Width>
            <ZIndex>2</ZIndex>
            <Style />
          </Textbox>
          <Textbox Name="ContactInfo">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Tel: " &amp; Fields!CompanyInfo_Phone.Value &amp; " | Email: " &amp; Fields!CompanyInfo_Email.Value</Value>
                    <Style>
                      <FontSize>8pt</FontSize>
                      <TextAlign>Left</TextAlign>
                      <Color>#333333</Color>
                      <PaddingLeft>0.05in</PaddingLeft>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
              </Paragraph>
            </Paragraphs>
            <Top>0.6in</Top>
            <Left>1in</Left>
            <Height>0.2in</Height>
            <Width>5.3in</Width>
            <ZIndex>3</ZIndex>
            <Style />
          </Textbox>
          <Line Name="HeaderLine">
            <Top>0.85in</Top>
            <Left>0.1in</Left>
            <Height>0.02in</Height>
            <Width>6.3in</Width>
            <ZIndex>4</ZIndex>
            <Style>
              <Border>
                <Color>#1a3c6e</Color>
                <Style>Solid</Style>
                <Width>2pt</Width>
              </Border>
            </Style>
          </Line>
          <Textbox Name="ReportTitle">
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>="Domains Under Management (DUM) as of " &amp; Format(Fields!As_Of_Date.Value, "dd-MMM-yyyy")</Value>
                    <Style>
                      <FontSize>13pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                      <TextAlign>Center</TextAlign>
                      <Color>#1a3c6e</Color>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style />
