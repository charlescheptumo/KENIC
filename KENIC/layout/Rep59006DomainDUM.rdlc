                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="RegName">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Registrar_Name.Value</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>=IIF(Fields!Registrar_Roid.Value = "TOTAL", "Bold", "Normal")</FontWeight>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style>
                            <Border>
                              <Color>#cccccc</Color>
                              <Style>Solid</Style>
                              <Width>0.5pt</Width>
                            </Border>
                            <BackgroundColor>=IIF(Fields!Registrar_Roid.Value = "TOTAL", "#e8f0fe", "Transparent")</BackgroundColor>
                            <TextAlign>Left</TextAlign>
                            <PaddingLeft>6pt</PaddingLeft>
                            <VerticalAlign>Middle</VerticalAlign>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DUMCount">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!DUM_Count.Value</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>=IIF(Fields!Registrar_Roid.Value = "TOTAL", "Bold", "Normal")</FontWeight>
                                    <TextAlign>Center</TextAlign>
                                    <Color>=IIF(Fields!Registrar_Roid.Value = "TOTAL", "#1a3c6e", "Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
