                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!Bankrupt_or_Insolvent.Value = true, "YES", "NO") &amp; IIf(IsNothing(Fields!Bankruptcy_Details.Value), "", ": " &amp; Fields!Bankruptcy_Details.Value)</Value>
