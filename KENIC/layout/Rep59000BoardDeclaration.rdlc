                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Q1">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>1. Convicted of a criminal offense?</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <PaddingLeft>4pt</PaddingLeft>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style />
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Q1Response">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIF(Fields!Convicted_of_Crime.Value = true, "YES", "NO") &amp; IIf(IsNothing(Fields!Conviction_Details.Value), "", ": " &amp; Fields!Conviction_Details.Value)</Value>
                                  <Style>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>=IIF(Fields!Convicted_of_Crime.Value = true, "Bold", "Normal")</FontWeight>
                                    <Color>=IIF(Fields!Convicted_of_Crime.Value = true, "#dc3545", "#28a745")</Color>
                                    <PaddingLeft>4pt</PaddingLeft>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style />
                            </Paragraph>
                          </Paragraphs>
                          <Style />
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <TablixRow>
                  <Height>0.35in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Q2">
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>2. Bankrupt or insolvent?</Value>
                                  <Style>
